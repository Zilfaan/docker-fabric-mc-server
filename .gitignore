# Ignore everything inside data
data/*

# EXCEPT keep the folder itself
!data/
!data/.gitkeep

# Server generated stuff
*.log
*.log.gz
*.tmp

# Minecraft worlds
data/world/
data/world_nether/
data/world_the_end/

# Player data
data/playerdata/
data/whitelist.json
data/ops.json
data/banned-players.json
data/banned-ips.json

# Config files generated by server
data/server.properties
data/eula.txt
data/usercache.json

# Mods and configs
data/mods/
data/config/

# Fabric launch jars
data/fabric-server-launcher.jar
data/fabric-installer.jar
data/fabric-server-launch.jar

# IDE folders
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db

.env